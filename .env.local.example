# ==============================================================================
# SupoClip - Configuração 100% Local (Docker + Whisper + Ollama)
# ==============================================================================
# Copie este arquivo para .env para rodar localmente sem nenhuma chave paga:
#   cp .env.local.example .env
#   docker compose up -d

# --- Transcrição Local (Whisper) ---
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=medium
TRANSCRIPTION_LANGUAGE=pt

# --- LLM Local (Ollama) ---
LLM=ollama:qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=
RERANK_LLM=

# --- URLs e Portas Locais ---
BETTER_AUTH_URL=http://localhost:3107
NEXT_PUBLIC_APP_URL=http://localhost:3107
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:9100

# --- Chaves Secretas Locais ---
BETTER_AUTH_SECRET=local_dev_better_auth_secret_32bytes_long!
INTERNAL_ADMIN_TOKEN=change_me_super_secret_admin_token
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
RUNTIME_SETTINGS_ENCRYPTION_KEY=

# --- Banco de Dados e Cache ---
DATABASE_URL=postgresql://supoclip:supoclip@postgres:5432/supoclip
REDIS_URL=redis://redis:6379/0

# --- Outras Configurações Locais ---
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip
POSTGRES_DB=supoclip
DEFAULT_PROCESSING_MODE=fast
MAX_CLIPS=10
